{
    "name": "windows-d",
    "description": "The D Windows SDK projections",
    "authors": [
        "Răzvan Ștefănescu"
    ],
    "license": "BSL-1.0",
	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode",
				"debugInfo",
				"optimize"
			]
		},
		"release": {
			"buildOptions": [
				"releaseMode",
				"inline",
				"optimize"
			]
		}
	},
    "dependencies": {
        "windows-d:wind": "*",
        "windows-d:windows": "*"
    },
    "subPackages": [
        {
            "name": "wind",
            "description": "The D Windows SDK projection generator",
            "targetName": "wind",
            "targetType": "executable",
            "targetPath": "bin/$BUILD_TYPE",
            "sourcePaths": [
                "src"
            ]
        },
        {
            "name": "windows",
            "description": "The D Windows SDK projection library",
            "targetType": "staticLibrary",
            "targetName": "windows",
            "targetPath": "bin/$BUILD_TYPE",
            "sourcePaths": [
                "out/windows"
            ],
            "importPaths": [
                "out"
            ]
        },
        {
            "name": "default",
            "targetType": "none"
        }
    ]
}