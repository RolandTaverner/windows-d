{
    "name": "wind",
    "description": "The D Windows SDK projections generator",
    "authors": [
        "Răzvan Ștefănescu",
        "Alexander Verbitsky"
    ],
    "license": "BSL-1.0",
    "sourcePaths": [
        "source"
    ],
    "buildTypes": {
        "debug": {
            "buildOptions": [
                "debugMode",
                "debugInfo",
                "optimize"
            ]
        },
        "release": {
            "buildOptions": [
                "releaseMode",
                "inline",
                "optimize"
            ]
        }
    },
    "targetName": "wind",
    "targetType": "executable",
    "targetPath": "bin/$BUILD_TYPE"
}
